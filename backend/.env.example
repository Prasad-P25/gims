# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/gims_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gims_db
DB_USER=postgres
DB_PASSWORD=your_password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_VOICE=your_optional_second_gemini_key

# Telegram Bot (Optional - alternative to WhatsApp)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
VOICE_MESSAGE_DIR=./uploads/voice

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Reminder Settings
MORNING_REMINDER_TIME=09:00
EVENING_REMINDER_TIME=18:00
